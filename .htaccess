# PackLik — Apache
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
# rien d'interne n'est servi : base SQLite, configuration, tests, bibliothèques de l'API
RewriteRule ^(data|tests|\.git)(/|$) - [F,L]
RewriteRule ^(config\.php|router\.php|.*\.(sqlite|md|sql))$ - [F,L]
RewriteRule ^api/(lib|carriers|carriers_catalog)\.php$ - [F,L]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(css|js|png|jpg|jpeg|webp)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
</IfModule>
